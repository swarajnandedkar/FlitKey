{
  "app-id": "xyz.flitkey.FlitKey",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.6",
  "sdk": "org.kde.Sdk",
  "command": "flitkey",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=all",
    "--filesystem=home"
  ],
  "modules": [
    {
      "name": "flitkey",
      "buildsystem": "simple",
      "build-commands": [
        "install -d /app/opt/flitkey",
        "cp -r * /app/opt/flitkey/",
        "install -d /app/bin",
        "echo '#!/bin/sh' > /app/bin/flitkey",
        "echo 'exec python3 /app/opt/flitkey/run.py \"$@\"' >> /app/bin/flitkey",
        "chmod +x /app/bin/flitkey",
        "install -Dm644 assets/flitkey.svg /app/share/icons/hicolor/scalable/apps/xyz.flitkey.FlitKey.svg"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/swarajnandedkar/FlitKey.git",
          "tag": "v0.4.0"
        }
      ]
    }
  ]
}
